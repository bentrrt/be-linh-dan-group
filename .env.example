# ─────────────────────────────────────────────────────────────────────────────
# Asparagus Tracking System — Backend API
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection.
# Inside the Docker network use the DB service hostname "postgres".
# For local (host) runs against the published port, use "localhost".
DB_HOST=postgres
DB_PORT=5432
DB_NAME=Asparaguspgdb
DB_USER=admin
DB_PASSWORD=AsparagusPass123
DB_SCHEMA=public

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins ("*" to allow all)
CORS_ORIGINS=*
